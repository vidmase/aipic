import { QuotaManager } from '@/lib/quota-manager';
import { createServiceRoleClient } from '@/lib/supabase/server';

jest.mock('@/lib/supabase/server');

const mockedCreateServiceRoleClient = createServiceRoleClient as jest.Mock;

describe('Admin Quota System', () => {
  let quotaManager: QuotaManager;
  let mockSupabaseClient: any;

  beforeEach(() => {
    mockSupabaseClient = {
      from: jest.fn().mockReturnThis(),
      select: jest.fn().mockReturnThis(),
      update: jest.fn().mockReturnThis(),
      insert: jest.fn().mockReturnThis(),
      eq: jest.fn().mockReturnThis(),
      gte: jest.fn().mockReturnThis(),
      single: jest.fn().mockReturnThis(),
    };
    mockedCreateServiceRoleClient.mockReturnValue(mockSupabaseClient);
    quotaManager = new QuotaManager();
    jest.clearAllMocks();
    mockedCreateServiceRoleClient.mockReturnValue(mockSupabaseClient);
  });

  describe('QuotaManager', () => {
    describe('getUserTier', () => {
      it('should return user tier information', async () => {
        const mockProfile = { user_tier: 'premium', is_premium: true };
        mockSupabaseClient.from.mockReturnValue({
            select: jest.fn().mockReturnThis(),
            eq: jest.fn().mockReturnThis(),
            single: jest.fn().mockResolvedValue({ data: mockProfile }),
        });

        const result = await quotaManager.getUserTier('test-user-id');

        expect(result).toEqual({ tier: 'premium', is_premium: true });
        expect(mockSupabaseClient.from).toHaveBeenCalledWith('profiles');
      });
    });

    describe('checkQuota', () => {
        it('should allow generation when under quota limits', async () => {
          const mockProfile = { user_tier: 'free', is_premium: false };
          const mockQuotaLimits = { daily_limit: 3, monthly_limit: 90, hourly_limit: 2 };
          const mockModel = { id: 'model-uuid' };
          const mockUsage = [{ images_generated: 1 }];

          // Mock the chain for different tables
          mockSupabaseClient.from.mockImplementation((table: string) => {
            switch (table) {
              case 'profiles':
                return {
                  select: jest.fn().mockReturnThis(),
                  eq: jest.fn().mockReturnThis(),
                  single: jest.fn().mockResolvedValueOnce({ data: mockProfile }),
                };
              case 'quota_limits':
                return {
                  select: jest.fn().mockReturnThis(),
                  eq: jest.fn().mockReturnThis(),
                  single: jest.fn().mockResolvedValueOnce({ data: mockQuotaLimits }),
                };
              case 'image_models':
                return {
                  select: jest.fn().mockReturnThis(),
                  eq: jest.fn().mockReturnThis(),
                  single: jest.fn().mockResolvedValueOnce({ data: mockModel }),
                };
              case 'usage_tracking':
                 return {
                    select: jest.fn().mockReturnThis(),
                    eq: jest.fn().mockReturnThis(),
                    gte: jest.fn().mockResolvedValue({ data: mockUsage }),
                };
              default:
                return mockSupabaseClient;
            }
          });

          const result = await quotaManager.checkQuota('user-id', 'fal-ai/fast-sdxl');

          expect(result.allowed).toBe(true);
          expect(result.usage.daily).toBe(1);
          expect(result.limits.daily).toBe(3);
        });
      });

      describe('trackUsage', () => {
        it('should successfully track usage by updating existing record', async () => {
          const mockModel = { id: 'model-uuid' };
          const existingRecord = { images_generated: 1 };

          const updateMock = jest.fn().mockReturnThis();
          const eqMock = jest.fn().mockResolvedValue({ error: null });
          updateMock.mockReturnValue({ eq: eqMock });

          mockSupabaseClient.from.mockImplementation((table: string) => {
            if (table === 'image_models') {
              return {
                select: jest.fn().mockReturnThis(),
                eq: jest.fn().mockReturnThis(),
                single: jest.fn().mockResolvedValue({ data: mockModel }),
              };
            }
            if (table === 'usage_tracking') {
              return {
                select: jest.fn().mockReturnThis(),
                eq: jest.fn().mockReturnThis(),
                single: jest.fn().mockResolvedValue({ data: existingRecord }),
                update: updateMock,
              };
            }
            return mockSupabaseClient;
          });

          const result = await quotaManager.trackUsage('user-id', 'fal-ai/fast-sdxl', 2);

          expect(result).toBe(true);
          expect(updateMock).toHaveBeenCalledWith({
            images_generated: existingRecord.images_generated + 2,
          });
        });
      });
  });
});